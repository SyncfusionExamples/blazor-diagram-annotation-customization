    // -------------------------------------------------------
    // 1. Custom Command: CanExecute
    // -------------------------------------------------------
    private void CanExecute(CommandKeyArgs args)
    {
        args.CanExecute = true;
    }

    // -------------------------------------------------------
    // 1. Custom Command: Execute
    // -------------------------------------------------------
    private void CommandExecute(CommandKeyArgs args)
    {
        // Ctrl+G → Group selected nodes
        if (args.Gesture.Modifiers == ModifierKeys.Control &&
            args.Gesture.Key == DiagramKeys.F)
        {
            Diagram.Group();
        }

        // Ctrl+U → Ungroup selected items
        if (args.Gesture.Modifiers == ModifierKeys.Control &&
            args.Gesture.Key == DiagramKeys.J)
        {
            DiagramSelectionSettings selector = Diagram.SelectionSettings;
            if (selector.Nodes.Count > 0 && selector.Nodes[0] is NodeGroup group)
            {
                if (group.Children.Length > 0)
                {
                    Diagram.Ungroup();
                }
            }
        }
    }

